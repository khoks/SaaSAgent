{
  "name": "saasagent",
  "version": "0.0.0",
  "private": true,
  "description": "SaaSAgent — universal embeddable agentic harness for SaaS enterprises",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean": "turbo clean && rm -rf node_modules .turbo",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/docker-compose.yml down -v",
    "demo": "node scripts/demo.mjs",
    "demo:no-build": "node scripts/demo.mjs --no-build",
    "demo:no-open": "node scripts/demo.mjs --no-open",
    "demo:host": "pnpm --filter @saasagent/demo-host dev",
    "demo:runtime": "pnpm --filter @saasagent/runtime build && node packages/runtime/dist/index.js"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
