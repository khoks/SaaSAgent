# SaaSAgent environment variables.
# Copy to `.env.local` (gitignored) for local development.

# Anthropic API key — required by HaikuComposer (Phase 1.3+).
# Get one at https://console.anthropic.com/. Without this, the runtime falls back
# to StubComposer (deterministic hand-crafted layouts; useful for offline dev / CI).
ANTHROPIC_API_KEY=

# Runtime port (default 8080).
# SAAS_AGENT_PORT=8080
